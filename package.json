{
  "name": "horun-drama-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "HorunDrama 手机端（Android 客户端 + 局域网核心）",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @horun/mobile-web run build",
    "start": "node apps/mobile-core/src/index.ts",
    "typecheck": "pnpm -r --parallel run typecheck"
  }
}
